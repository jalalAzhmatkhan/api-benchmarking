# graphify knowledge-graph exclusions (fnmatch patterns, matched against each path segment).
# Goal: keep the graph to source code, specs, scripts and docs. Skip anything generated,
# vendored, binary or bulky so `graphify update` stays fast and the graph stays meaningful.

# VCS / tooling
.git
.github/ISSUE_TEMPLATE
graphify-out
.claude
.rtk

# Dependencies & virtual environments
node_modules
.venv
venv
vendor
.mvn
.gradle

